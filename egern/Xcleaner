name: "X/Twitter 评论区垃圾与黄推过滤"
scriptings:
  - http_response:
      # 匹配 X GraphQL 评论区主接口与下滑加载接口
      match: "^https?://api\\.(x|twitter)\\.com/graphql/.+/(TweetDetail|ConversationTimeline)"
      script_url: "https://raw.githubusercontent.com/jackmoo1/xray/refs/heads/main/egern/Xcleaner.js" 
      body_required: true
      max_size: 3145728 
mitm:
  hostnames:
    - "api.x.com"
    - "api.twitter.com"
